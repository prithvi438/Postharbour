# Local-only settings for `docker compose up --build`.
# Copy to .env. Production must use new secrets, HTTPS, and MAIL_PROVIDER=stalwart.
POSTGRES_USER=postharbor
POSTGRES_PASSWORD=local-database-password
POSTGRES_DB=postharbor
POSTGRES_PORT=5433
APP_ORIGIN=http://localhost:8080
BOOTSTRAP_EMAIL=owner@example.test
BOOTSTRAP_PASSWORD=local-development-password
MAIL_PROVIDER=simulation
MAX_MAILBOXES=5
MAIL_HOST=mail.example.com
WEBMAIL_URL=
# Native launcher / compose.demo.yml set this for local webmail testing only.
MAILPIT_URL=
STALWART_URL=
STALWART_TOKEN=
# Used only by compose.prod.yml / Caddy. Set an actual hostname before deploying.
APP_DOMAIN=panel.example.com

# Live hosting only. Community enforces one business; default is enterprise.
STALWART_EDITION=enterprise
# Enable live /mail with a 64-character random hex key, stored outside Git.
WEBMAIL_SESSION_KEY=
